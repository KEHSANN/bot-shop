# ==============================================================================
# Telegram Digital Shop Bot - Environment Configuration Template
# Copy this file to .env and replace all CHANGE_ME values with strong secrets,
# or generate a ready-to-run .env via: python3 scripts/gen_secrets.py --write-env
# ==============================================================================

# --- Application & Runtime ---
APP_NAME="Telegram Digital Shop"
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
DEFAULT_LANGUAGE=en
TZ=UTC
APP_HOST=0.0.0.0
APP_PORT=8000
DOMAIN=shop.example.com

# --- Telegram Bot ---
BOT_TOKEN=0000000000:CHANGE_ME_TELEGRAM_BOT_TOKEN
# Use "webhook" behind Nginx+SSL in production, or "polling" for dev without domain
BOT_MODE=webhook
BOT_WEBHOOK_URL=https://shop.example.com/webhook/telegram
BOT_WEBHOOK_PATH=/webhook/telegram
BOT_WEBHOOK_SECRET=CHANGE_ME_RANDOM_WEBHOOK_SECRET
TELEGRAM_BOT_USERNAME=
WEBAPP_URL=https://shop.example.com/miniapp
MINIAPP_BASE_URL=https://shop.example.com/miniapp
# Comma-separated numeric Telegram User IDs for bot admins
ADMIN_TELEGRAM_IDS=123456789

# --- Web Admin Auth & Cryptography ---
WEB_ADMIN_USERNAME=admin
# Bcrypt hash (wrap in single quotes so $ is not expanded by docker compose)
WEB_ADMIN_PASSWORD_HASH='$2b$12$CHANGE_ME_REPLACE_WITH_BCRYPT_HASH'
JWT_SECRET_KEY=CHANGE_ME_GENERATE_64_HEX_CHARS
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
CSRF_SECRET_KEY=CHANGE_ME_GENERATE_64_HEX_CHARS
ADMIN_SECRET_KEY=CHANGE_ME_GENERATE_64_HEX_CHARS
# Valid 32-byte URL-safe base64 Fernet key (44 characters)
ENCRYPTION_KEY=CHANGE_ME_GENERATE_VALID_FERNET_KEY_44_CHARS=
TWO_FACTOR_ENABLED=false
TOTP_SECRET=
TELEGRAM_LOGIN_WIDGET_ENABLED=true

# --- PostgreSQL 16 ---
POSTGRES_DB=telegram_shop
POSTGRES_USER=shopbot
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://shopbot:CHANGE_ME_STRONG_DB_PASSWORD@127.0.0.1:5432/telegram_shop

# --- Redis 7 ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_STRONG_REDIS_PASSWORD@127.0.0.1:6379/0

# --- Currency & Exchange Rate ---
USD_TO_TOMAN_RATE=65000
RATE_MODE=manual

# --- Security, Rate Limiting, Uploads & Broadcast ---
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=3
DEPOSIT_COOLDOWN_SECONDS=10
SUPPORT_COOLDOWN_SECONDS=5
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5
BROADCAST_RATE_PER_SEC=25

# --- Optional Payment Gateways & Blockchain Explorers ---
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
ZIBAL_MERCHANT=
NEXTPAY_API_KEY=
IDPAY_API_KEY=
TRONGRID_API_KEY=
BSCSCAN_API_KEY=
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
OXAPAY_MERCHANT_API_KEY=
